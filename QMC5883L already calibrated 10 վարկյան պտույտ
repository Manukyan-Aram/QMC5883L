#include <Wire.h>

#define QMC_ADDR 0x0D

// Գլոբալ փոփոխականներ
int16_t raw_x, raw_y, raw_z; 
const int numReadings = 10;
float readingsX[numReadings], readingsY[numReadings];
int readIndex = 0;
float totalX = 0, totalY = 0;

// Կալիբրացիայի փոփոխականներ
int16_t minX = 32767, maxX = -32768;
int16_t minY = 32767, maxY = -32768;
float offsetX = 0, offsetY = 0;

void readRaw() {
  Wire.beginTransmission(QMC_ADDR);
  Wire.write(0x00);
  Wire.endTransmission(false);
  Wire.requestFrom(QMC_ADDR, 6);
  if (Wire.available() >= 6) {
    raw_x = (int16_t)(Wire.read() | (Wire.read() << 8));
    raw_y = (int16_t)(Wire.read() | (Wire.read() << 8));
    raw_z = (int16_t)(Wire.read() | (Wire.read() << 8));
  }
}

void setup() {
  Serial.begin(9600);
  Wire.begin();

  // Սենսորի կարգավորումներ
  Wire.beginTransmission(QMC_ADDR);
  Wire.write(0x09); Wire.write(0x1D);
  Wire.endTransmission();
  Wire.beginTransmission(QMC_ADDR);
  Wire.write(0x0B); Wire.write(0x01);
  Wire.endTransmission();

  Serial.println("Կալիբրացիա... Պտտեք սարքը բոլոր ուղղություններով 10 վայրկյան:");
  unsigned long startMillis = millis();
  while (millis() - startMillis < 10000) {
    readRaw();
    if (raw_x < minX) minX = raw_x; 
    if (raw_x > maxX) maxX = raw_x;
    if (raw_y < minY) minY = raw_y; 
    if (raw_y > maxY) maxY = raw_y;
    delay(20);
  }
  
  offsetX = (maxX + minX) / 2.0;
  offsetY = (maxY + minY) / 2.0;
  Serial.println("Կալիբրացիան ավարտված է!");
}

void loop() {
  readRaw();

  // Միջինացման ֆիլտր
  totalX = totalX - readingsX[readIndex] + (raw_x - offsetX);
  totalY = totalY - readingsY[readIndex] + (raw_y - offsetY);
  readingsX[readIndex] = (raw_x - offsetX);
  readingsY[readIndex] = (raw_y - offsetY);
  readIndex = (readIndex + 1) % numReadings;

  float avgX = totalX / numReadings;
  float avgY = totalY / numReadings;

  float heading = atan2(avgY, avgX) * 180.0 / PI + 6.1;
  if (heading < 0) heading += 360;
  if (heading > 360) heading -= 360;

  Serial.print("Անկյուն: "); Serial.println(heading);
  delay(100);
}
